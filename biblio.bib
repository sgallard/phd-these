@inproceedings{teixeira-2025,
author = {Teixeira, Matheus C{\^a}ndido and Pappa, Gisele Lobo},
title = {Transformers as Surrogate Models for Genetic Programming in Auto{ML} Tasks},
year = {2025},
isbn = {9798400714658},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
doi = {10.1145/3712256.3726396},
abstract = {In applications where the fitness function has a high computational cost, one of the main drawbacks of Evolutionary Algorithms when compared to other search methods is a prohibitive computational cost. The use of surrogates as proxies for fitness function calculation to alleviate this problem is not new, but addressing the problem as a binary relation learning, i.e., evaluating if one individual is better or worse than another without estimating the actual value of the fitness, is a recent trend.This paper proposes a transformer-encoder as a surrogate to evaluate pairs of solutions and determine their relationship, i.e., which one is better/worse than the other. We experimented the model in the context of AutoML, which seeks to find the best combination of algorithms for a classification problem. To optimize the pipeline, we can use a genetic programming, but the cost of evaluating each individual is generally expensive.We trained the encoder with several parameters and compared its performance against traditional GP - evaluating fitness at each generation. Results confirm using the encoder as a surrogate does not degrade the fitness values of the evolved population of ML pipelines and can even improve it in some cases (up to 285 times faster).},
booktitle = {Proceedings of the Genetic and Evolutionary Computation Conference},
pages = {472--480},
numpages = {9},
keywords = {tranformers, fitness surrogates, AutoML},
location = {NH Malaga Hotel, Malaga, Spain},
series = {GECCO '25}
}

