@inproceedings{hornb_reading_2001,
author = {Hornb{\ae}k, Kasper and Fr{\o}kj{\ae}r, Erik},
title = {Reading of electronic documents: the usability of linear, fisheye, and overview+detail interfaces},
year = {2001},
isbn = {1581133278},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/365024.365118},
doi = {10.1145/365024.365118},
abstract = {Reading of electronic documents is becoming increasingly important as more information is disseminated electronically. We present an experiment that compares the usability of a linear, a fisheye, and an overview+detail interface for electronic documents. Using these interfaces, 20 subjects wrote essays and answered questions about scientific documents. Essays written using the overview+detail interface received higher grades, while subjects using the fisheye interface read documents faster. However, subjects used more time to answer questions with the overview+detail interface. All but one subject preferred the overview+detail interface. The most common interface in practical use, the linear interface, is found to be inferior to the fisheye and overview+detail interfaces regarding most aspects of usability. We recommend using overview+detail interfaces for electronic documents, while fisheye interfaces mainly should be considered for time-critical tasks.},
booktitle = {Proceedings of the {SIGCHI} Conference on Human Factors in Computing Systems},
pages = {293–300},
numpages = {8},
keywords = {electronic documents, information retrieval, information visualization, reading activity, usability, user study},
location = {Seattle, Washington, USA},
series = {CHI '01}
}


@article{atata_evaluating_2025,
	title = {Evaluating {Visual} {Hierarchies} and {Navigation} {Patterns} to {Improve} {Accessibility}},
	volume = {6},
	issn = {25827421},
	doi = {10.55248/gengpi.6.0825.3080},
	abstract = {Accessibility and user engagement remain central to the design of contemporary digital platforms, where increasingly diverse audiences interact with content across devices, operating systems, and assistive technologies. From a broad perspective, accessibility compliance is not only a legal and ethical requirement but also a strategic enabler of inclusivity and retention. Central to this objective is the effective use of visual hierarchies and navigation patterns, which determine how users perceive, interpret, and interact with digital content. A well-structured hierarchy facilitates cognitive processing by guiding attention toward essential elements while reducing cognitive overload, thereby enabling smoother user journeys. At the same time, coherent navigation patterns ensure that users can move seamlessly through interfaces regardless of platform or device, reinforcing consistency and predictability. This study evaluates the interplay between visual design principles and navigational structures in fostering accessibility compliance with frameworks such as WCAG 2.1, while also examining their influence on cross-platform user engagement. It considers design elements such as contrast, typography, spatial organization, and the integration of adaptive layouts, alongside navigational strategies like linear flows, breadcrumb trails, and multimodal inputs. Findings highlight that platforms adopting accessible hierarchies and consistent navigation achieve higher engagement, particularly among users with disabilities and those accessing content across multiple devices. Furthermore, evidence suggests that accessibility-driven design directly correlates with brand loyalty, reduced abandonment rates, and improved cross-platform experiences. The research underscores the need for organizations to prioritize accessibility as a driver of engagement, rather than an afterthought, by embedding it into design processes that emphasize clarity, inclusivity, and universal usability.},
	language = {en},
	number = {8},
	urldate = {2025-11-19},
	journal = {International Journal of Research Publication and Reviews},
	author = {Atata, Raheemat},
	year = {2025},
	pages = {617--641},
}

@mastersthesis{aljoudi,
	title = {Direct {Manipulation} of {AI} {Text} via {Gestures}},
	abstract = {This thesis investigates why current chatbot interfaces often feel rigid and inefficient for users, especially during tasks like drafting emails, and explores an alternative interaction model. The research first gathered insights from semi-structured interviews and design probes to pinpoint frustrations with sequential, text-based chatbot use. These insights informed the development of a novel prototype that uses a Leap Motion sensor to capture hand gestures, allowing users to manipulate chatbotgenerated text directly. The prototype maps intuitive gestures (e.g., sliding a hand upward to formalize tone) to real-time text edits, effectively merging conversational AI with direct manipulation. In user testing, participants found the gesture-driven interface highly intuitive and felt more in control of the chatbot’s output compared to traditional typing. They could, for example, instantly adjust a message’s tone or politeness with simple motions, reducing the need for iterative text prompts. Participants also highlighted the need for dynamic text generation integrated with gesture controls. The results show that a gesture-based model can make chatbot interactions more flexible and efficient, pointing toward a new multimodal paradigm for conversational interfaces.},
	language = {en},
	year = {2020},
	author = {Aljoudi, Ahmad},
  school = {Malmö University, Faculty of Culture and Society (KS), School of Arts and Communication (K3)},
	type={Bachelor's Thesis}
}

@article{priyadarshini_impact_2024,
	title = {The {Impact} of {User} {Interface} {Design} on {User} {Engagement}},
	volume = {13},
	abstract = {In the digital era, user engagement stands as a critical metric for the success of digital products and platforms, with user interface (UI) design playing a pivotal role in shaping engagement levels. This abstract delves into the multifaceted relationship between UI design and user engagement, synthesizing existing literature and empirical findings to elucidate key insights and implications. Research indicates that UI design significantly influences user engagement through various factors such as usability, accessibility, visual aesthetics, interactivity, and personalization. Intuitive layouts, clear navigation, appealing visual aesthetics, and responsive interactions contribute to seamless user experiences that captivate users' attention and encourage interaction. Furthermore, personalization features, social integration, and emotional design elements enhance engagement by fostering a sense of connection, belonging, and satisfaction. However, challenges remain in understanding the nuanced interplay between design factors and user behaviors, particularly in diverse cultural contexts and emerging technologies. This abstract calls for continued research efforts to deepen our understanding of UI design principles and their implications for user engagement, urging interdisciplinary collaborations and innovative methodologies to address current gaps and challenges.},
	language = {en},
	number = {03},
	journal = {International Journal of Engineering Research},
	author = {Priyadarshini, Ar Poorva},
	year = {2024}
}


