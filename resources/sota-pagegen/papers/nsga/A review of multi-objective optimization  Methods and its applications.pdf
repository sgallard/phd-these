               <rdf:li>hybrid algorithm</rdf:li>
               <rdf:li>lexisearch algorithm</rdf:li>
               <rdf:li>genetic algorithm</rdf:li>
               <rdf:li>multi-parent crossover</rdf:li>
               <rdf:li>sequential constructive crossover</rdf:li>
               <rdf:li>adaptive mutation</rdf:li>
            </rdf:Bag>
